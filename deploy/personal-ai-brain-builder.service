[Unit]
Description=Personal AI Brain local Work Runner v0.1
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=pab-builder
Group=pab-builder
WorkingDirectory=/var/lib/personal-ai-brain/builder
Environment=PYTHONPATH=/opt/personal-ai-brain/builder/src
ExecStart=/opt/personal-ai-brain/builder/venv/bin/python -B -m personal_ai_brain.work_runner serve
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/personal-ai-brain/builder
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
# Do not mask subpaths of the supervisor's /proc: Linux refuses nested private
# proc mounts from an unprivileged user namespace over such a parent mount.
# Task proc is private and read-only; host kernel writes remain denied by UID/caps.
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
TasksMax=64
MemoryMax=256M
CPUQuota=100%
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
