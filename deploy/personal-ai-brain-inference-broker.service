[Unit]
Description=Personal AI Brain trusted Responses inference broker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pab-inference
Group=pab-builder
WorkingDirectory=/var/lib/personal-ai-brain/inference
Environment=PYTHONPATH=/opt/personal-ai-brain/builder/src
ExecStart=/opt/personal-ai-brain/builder/venv/bin/python -B -m personal_ai_brain.inference_broker
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=5
UMask=0077
RuntimeDirectory=personal-ai-brain-inference
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/personal-ai-brain/inference /run/personal-ai-brain-inference
# Hide host state and /etc; bind only explicit broker dependencies back in.
# Actual-identity namespace/DNS/IPC probes are required before live enablement.
TemporaryFileSystem=/var/lib:ro /run:ro /etc:ro
BindPaths=/var/lib/personal-ai-brain/inference /run/personal-ai-brain-inference
BindReadOnlyPaths=/etc/personal-ai-brain/inference/credentials
BindReadOnlyPaths=/etc/ssl/certs /etc/resolv.conf /etc/hosts /etc/nsswitch.conf /etc/passwd /etc/group
TasksMax=8
MemoryMax=192M
CPUQuota=100%
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
